{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dessert-drop",
	"main": "src/worker.js",
	"compatibility_date": "2026-11-13",
	// Built by `npm run build` (tools/build_web.sh) from the Godot "Web" preset.
	"assets": {
		"directory": "./export/web",
		"binding": "ASSETS",
		// Serve files at their exact names. The default ("auto-trailing-slash")
		// 307-redirects /index.html -> / and /index.offline.html -> /index.offline.
		// Godot's PWA service worker precaches those names, and Safari refuses
		// to show a page the service worker answers with a redirected response
		// ("Response served by service worker has redirections").
		"html_handling": "none",
		// The Worker serves "/" (as /index.html) and the oversized engine file
		// (see src/worker.js); everything else goes straight to the assets layer.
		"run_worker_first": ["/", "/index.wasm"]
	},
	"routes": [
		{
			"pattern": "dessert-drop.jonstuebe.com",
			"custom_domain": true
		}
	],
	// PR/branch Previews (`wrangler preview`, run by Workers Builds on
	// non-production branches). Top-level assets/compat settings apply; the
	// production custom domain intentionally does not.
	"previews": {},
	// Serve per-version Preview URLs at <version>-dessert-drop.<subdomain>.workers.dev.
	"preview_urls": true,
	"observability": {
		"enabled": true
	}
}
