; Engine configuration file.
config_version=5

[application]

config/name="Dessert Drop"
config/description="Drop and merge desserts in a glass jar."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/art/d5_donut.svg"

[autoload]

Save="*res://scripts/save.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1480
window/size/window_width_override=405
window/size/window_height_override=832
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom_font="res://assets/fonts/Fredoka.ttf"



[physics]

2d/default_gravity=1750.0
common/physics_ticks_per_second=120
2d/solver/solver_iterations=24

[rendering]

renderer/rendering_method="mobile"
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_2d=2
